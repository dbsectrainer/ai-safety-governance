# Copy to .env for local Docker Compose or export these variables locally.
# Never commit a populated .env file.

# --- Backend ---------------------------------------------------------------
# REQUIRED in production: a long random string used to sign JWTs.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local development defaults to SQLite when DATABASE_URL is unset.
# DATABASE_URL=sqlite:///./ai_safety_governance.db
# Docker Compose supplies its own PostgreSQL DATABASE_URL.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ai_safety_governance

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_AUTO_INIT=true
# COMPLIANCE_AUDIT_DIR=/absolute/path/to/audit/logs

# Optional bootstrap administrator (created at startup if both are set).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_FULL_NAME=Platform Administrator

# --- Frontend --------------------------------------------------------------
# Leave VITE_API_URL empty to use the Vite /api reverse proxy (recommended).
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
